# Server
PORT=3001
NODE_ENV=development
SESSION_SECRET=your-super-secret-session-key-change-in-production

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Spotify API
# Get these from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:3001/api/auth/spotify/callback

# Apple Music API
# Get these from https://developer.apple.com/account/resources/authkeys/list
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
# Path to your .p8 private key file
APPLE_PRIVATE_KEY_PATH=./keys/AuthKey_XXXXXXXXXX.p8

# YouTube Music (via ytmusicapi)
# OAuth credentials from Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/youtube/callback
